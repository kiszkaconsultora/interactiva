---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/core/Button.astro';
import ContactBlock from '../components/marketing/ContactBlock.astro';
import Planet from '../components/marketing/Planet.astro';
import Section from '../components/marketing/Section.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import SpaceHero from '../components/marketing/SpaceHero.astro';
import StepItem from '../components/marketing/StepItem.astro';
import { ditSteps } from '../data/dit';
import { nasaImages } from '../data/site';

const phases = [
  {
    phase: 'Fase I',
    name: 'Descubrimiento y Concepción',
    stepsRange: 'Pasos 01 al 03',
    description: 'Exploración activa del entorno, detección de problemas reales u oportunidades latentes y diseño conceptual de soluciones diferenciales con modelo de negocio.',
    bullets: ['Explorar tendencias y tecnologías externas', 'Indagar problemáticas de mercado insatisfechas', 'Idear y diseñar propuestas de valor'],
  },
  {
    phase: 'Fase II',
    name: 'Validación y Capacidades',
    stepsRange: 'Pasos 04 al 06',
    description: 'Testeo con usuarios e interesados directos, diagnóstico sincero de fortalezas y debilidades, e incorporación ágil de nuevos saberes y alianzas clave.',
    bullets: ['Validar prototipos en entornos controlados', 'Diagnosticar capacidades operativas y brechas', 'Incorporar saberes, metodologías y talento'],
  },
  {
    phase: 'Fase III',
    name: 'Planificación y Escalado',
    stepsRange: 'Pasos 07 al 09',
    description: 'Construcción de la hoja de ruta estratégica, ejecución con monitoreo de indicadores de desempeño y consolidación de una narrativa de impacto para el mercado.',
    bullets: ['Planificar operaciones para mitigar la incertidumbre', 'Ejecutar soluciones y medir con métricas clave', 'Comunicar y posicionar la narrativa en el ecosistema'],
  },
];

const modalities = [
  {
    title: 'Startups y Empresas de Base Tecnológica (EBT)',
    lead: 'Acompañamiento especializado dentro de GII 5.0.',
    text: 'Guiamos a fundadores y equipos técnicos en la adopción de capacidades de innovación, vinculación tecnológica y gestión de propiedad intelectual indispensables para escalar.',
  },
  {
    title: 'Equipos Corporativos y Pymes',
    lead: 'Entrenamiento In-Company y descarga cognitiva.',
    text: 'Talleres inmersivos diseñados para desarticular cuellos de botella organizacionales, alinear objetivos estratégicos en soportes visuales y entrenar reflejos ante la Industria 4.0.',
  },
  {
    title: 'Laboratorio Phygital D!Cha',
    lead: 'Diseñando la Innovación Chaqueña.',
    text: 'Formato híbrido (físico y digital) orientado al prototipado acelerado de productos y servicios con fuerte identidad local y proyección global.',
  },
];
---

<BaseLayout
  title="Entrenamientos · Dispositivo DIT | Interactiva Hub"
  description="Entrenamientos de innovación y transformación en Interactiva Hub: el Dispositivo DIT en 9 pasos para gestionar eficientemente las fuentes del saber y escalar tu proyecto."
  active="/entrenamientos"
>
  <SpaceHero background="dawn" minHeight={480}>
    <div class="hero">
      <div class="copy">
        <div class="eyebrow">Gimnasio de Innovación · GII 5.0</div>
        <h1>Entrenamientos: Dispositivo DIT</h1>
        <p class="lead">
          Un camino secuencial y modular de 9 pasos diseñado para gestionar eficientemente las fuentes del saber, minimizar los riesgos de fracaso y transformar la visión en resultados medibles y sostenibles.
        </p>
        <div class="actions">
          <Button href="#trayectoria" iconRight="↓">Explorar los 9 pasos</Button>
          <Button href="/contacto" variant="ghost">Agendá un diagnóstico</Button>
        </div>
      </div>
      <div class="planet-wrap" aria-hidden="true">
        <Planet size={240} float><img src={nasaImages.astronautLunar} alt="" loading="eager" /></Planet>
      </div>
    </div>
  </SpaceHero>

  <Section labelledby="enfoque-title">
    <div id="enfoque-title">
      <SectionHeading
        eyebrow="Entrenamiento Estratégico"
        title="La innovación no se improvisa: se entrena"
        lead="En Interactiva Hub abordamos la innovación como una disciplina de alto rendimiento. El Dispositivo de Innovación y Transformación (DIT) estructura el recorrido en tres fases integradas para asegurar coherencia, solidez y minimización de riesgos."
        accent="var(--gii-2)"
      />
    </div>

    <div class="phases">
      {
        phases.map((p) => (
          <article class="phase-card">
            <div class="phase-badge">
              <span class="phase-tag">{p.phase}</span>
              <span class="phase-range">{p.stepsRange}</span>
            </div>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <ul class="phase-bullets">
              {p.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <Section background="sky" id="trayectoria" labelledby="trayectoria-title">
    <div id="trayectoria-title">
      <SectionHeading
        eyebrow="Metodología"
        title="Dispositivo DIT: 9 pasos, una trayectoria"
        lead="El Dispositivo DIT no es una creación nuestra: es una metodología existente que adoptamos y recomendamos. Propone un camino secuencial y modular para gestionar eficientemente las fuentes del saber y minimizar los riesgos de fracaso."
        accent="var(--gii-2)"
      />
    </div>

    <ol class="steps-grid">
      {
        ditSteps.map((s, i) => (
          <li>
            <StepItem n={i + 1} title={s.title} text={s.text} accent="var(--gii-2)" />
          </li>
        ))
      }
    </ol>
  </Section>

  <Section labelledby="modalidades-title">
    <div id="modalidades-title">
      <SectionHeading
        eyebrow="Modalidades"
        title="¿Cómo podés entrenar con nosotros?"
        lead="Propuestas diseñadas para adaptarse al estadio de madurez y a los objetivos estratégicos de cada equipo."
        accent="var(--gii-2)"
      />
    </div>

    <div class="modalities">
      {
        modalities.map((m) => (
          <article class="modality-card">
            <h3>{m.title}</h3>
            <div class="modality-lead">{m.lead}</div>
            <p>{m.text}</p>
          </article>
        ))
      }
    </div>

    <div class="ecosystem-banner">
      <div>
        <div class="eco-eyebrow">Ecosistema Integrado</div>
        <h3>Entrená en el Gimnasio de Innovación de Interactiva Hub</h3>
        <p>
          Combinamos infraestructura de pensamiento, laboratorios phygital y el espacio colaborativo de nuestro coworking en Resistencia para impulsar el crecimiento de tu organización.
        </p>
      </div>
      <div class="eco-actions">
        <Button href="/gimnasio-de-innovacion" iconRight="→">Conocé GII 5.0</Button>
        <Button href="/coworking" variant="ghost">Ver Espacios Coworking</Button>
      </div>
    </div>
  </Section>

  <div id="contacto">
    <ContactBlock
      email="kiskza.consultora@gmail.com"
      emailLabel="Esp. María José Kiszka, Directora Ejecutiva · Gimnasio de Innovación"
      accent="var(--gii-2)"
    />
  </div>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--space-7);
    align-items: center;
  }
  .copy { display: grid; gap: 24px; justify-items: start; }
  .eyebrow { font: var(--type-eyebrow); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gii-2); }
  h1 { font: var(--fw-black) clamp(34px, 4.4vw, 58px) / var(--lh-tight) var(--font-display); letter-spacing: -0.03em; color: var(--space-ink); }
  .lead { font: 400 var(--fs-lead) / 1.5 var(--font-body); color: var(--ink-2); max-width: 600px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
  .planet-wrap { display: flex; align-items: center; justify-content: center; }

  .phases {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 56px;
  }
  .phase-card {
    border: 1px solid var(--line-1);
    border-top: 6px solid var(--gii-2);
    padding: 28px 24px;
    background: var(--paper-0);
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .phase-badge {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }
  .phase-tag {
    font: 700 13px var(--font-condensed);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gii-2);
  }
  .phase-range {
    font: 400 13px var(--font-body);
    color: var(--ink-3);
  }
  .phase-card h3 { font: var(--type-h3); color: var(--space-ink); }
  .phase-card p { font: 400 15px/1.55 var(--font-body); color: var(--ink-2); }
  .phase-bullets {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
    border-top: 1px solid var(--line-1);
    padding-top: 12px;
  }
  .phase-bullets li {
    font: 400 14px/1.45 var(--font-body);
    color: var(--ink-3);
    position: relative;
    padding-left: 16px;
  }
  .phase-bullets li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--gii-2);
    font-weight: 700;
  }

  .steps-grid {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 32px;
    row-gap: 8px;
  }

  .modalities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 56px;
  }
  .modality-card {
    border: 1px solid var(--line-1);
    border-top: 6px solid var(--gii-2);
    padding: 28px 24px;
    background: var(--paper-0);
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .modality-card h3 { font: var(--type-h3); color: var(--space-ink); }
  .modality-lead {
    font: 600 13px var(--font-condensed);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gii-2);
  }
  .modality-card p { font: 400 15px/1.55 var(--font-body); color: var(--ink-2); }

  .ecosystem-banner {
    margin-top: 56px;
    padding: 40px;
    background: linear-gradient(135deg, var(--sky-1) 0%, var(--paper-0) 100%);
    border: 1px solid var(--sky-3);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .eco-eyebrow { font: var(--type-eyebrow); letter-spacing: 0.14em; text-transform: uppercase; color: var(--sky-5); margin-bottom: 8px; }
  .ecosystem-banner h3 { font: var(--type-h2); color: var(--space-ink); margin-bottom: 12px; }
  .ecosystem-banner p { font: 400 16px/1.5 var(--font-body); color: var(--ink-2); }
  .eco-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-end; }

  @media (max-width: 1100px) {
    .steps-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .phases, .modalities { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .hero, .ecosystem-banner { grid-template-columns: 1fr; gap: var(--space-5); }
    .planet-wrap { justify-content: flex-start; }
    .eco-actions { justify-content: flex-start; }
  }
  @media (max-width: 650px) {
    .phases, .modalities, .steps-grid { grid-template-columns: 1fr; }
    .ecosystem-banner { padding: 24px; }
  }
</style>
