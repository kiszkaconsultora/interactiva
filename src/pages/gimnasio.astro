---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/core/Button.astro';
import ContactBlock from '../components/marketing/ContactBlock.astro';
import Planet from '../components/marketing/Planet.astro';
import Section from '../components/marketing/Section.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import SpaceHero from '../components/marketing/SpaceHero.astro';
import StepItem from '../components/marketing/StepItem.astro';
import UnitHero from '../components/marketing/UnitHero.astro';
import { ditSteps } from '../data/dit';
import { nasaImages } from '../data/site';
import { unitBySlug } from '../data/units';

const unit = unitBySlug('gimnasio-de-innovacion');

// Text transcribed from the PROPÓSITO / VISIÓN / MISIÓN card images in docs/.
const pillars = [
  {
    label: 'Propósito',
    text: 'Convertir desafíos productivos, en soluciones de impacto sostenible, con optimización de tecnologías, procesos y recursos.',
  },
  {
    label: 'Visión',
    text: 'Gerenciar un centro de referencia de generación de escenarios futuros, para quienes buscan liderar el cambio en sus sectores, promoviendo una cultura del bienestar, la innovación estratégica y éxito colaborativo.',
  },
  {
    label: 'Misión',
    text: 'Impulsar a organizaciones, profesionales y emprendedores a superar desafíos de la industria 4.0 y 5.0 con herramientas de precisión, estrategias de alto rendimiento y acompañamiento centrado en el bienestar humano.',
  },
];

// The three DIT phases group the nine steps in `ditSteps`.
const phases = [
  {
    phase: 'Fase I',
    name: 'Descubrimiento y Concepción',
    stepsRange: 'Pasos 01 al 03',
    description: 'Exploración activa del entorno, detección de problemas reales u oportunidades latentes y diseño conceptual de soluciones diferenciales con modelo de negocio.',
    bullets: ['Explorar tendencias y tecnologías externas', 'Indagar problemáticas de mercado insatisfechas', 'Idear y diseñar propuestas de valor'],
  },
  {
    phase: 'Fase II',
    name: 'Validación y Capacidades',
    stepsRange: 'Pasos 04 al 06',
    description: 'Testeo con usuarios e interesados directos, diagnóstico sincero de fortalezas y debilidades, e incorporación ágil de nuevos saberes y alianzas clave.',
    bullets: ['Validar prototipos en entornos controlados', 'Diagnosticar capacidades operativas y brechas', 'Incorporar saberes, metodologías y talento'],
  },
  {
    phase: 'Fase III',
    name: 'Planificación y Escalado',
    stepsRange: 'Pasos 07 al 09',
    description: 'Construcción de la hoja de ruta estratégica, ejecución con monitoreo de indicadores de desempeño y consolidación de una narrativa de impacto para el mercado.',
    bullets: ['Planificar operaciones para mitigar la incertidumbre', 'Ejecutar soluciones y medir con métricas clave', 'Comunicar y posicionar la narrativa en el ecosistema'],
  },
];

// Programs (former GII 5.0 page) merged with training modalities (former Entrenamientos page).
const modalities = [
  {
    id: 'gii50',
    title: 'Startups y Empresas de Base Tecnológica (EBT)',
    lead: 'GII5.0 · Desarrollo de EBT',
    text: 'Un programa de acompañamiento integral para Empresas de Base Tecnológica: guiamos a fundadores y equipos técnicos en la adopción de capacidades de innovación, vinculación tecnológica y gestión de propiedad intelectual indispensables para escalar en el mercado actual.',
  },
  {
    id: 'in-company',
    title: 'Equipos Corporativos y Pymes',
    lead: 'Entrenamiento In-Company y descarga cognitiva.',
    text: 'Talleres inmersivos diseñados para desarticular cuellos de botella organizacionales, alinear objetivos estratégicos en soportes visuales y entrenar reflejos ante la Industria 4.0.',
  },
  {
    id: 'dicha',
    title: 'Laboratorio Phygital D!Cha',
    lead: 'Diseñando la Innovación Chaqueña.',
    text: 'Nuestro laboratorio de innovación en formato phygital (físico y digital). Es el espacio ideal para el prototipado rápido y la experimentación de productos y servicios con identidad local y visión global.',
  },
];

const infra = [
  { name: 'Vigilancia e Inteligencia Tecnológica', text: 'Monitoreo sistemático de patentes y tendencias para reducir la incertidumbre.' },
  { name: 'Adaptación a la Industria 4.0', text: 'Diseño de procesos gestionados por indicadores y entrenamiento de equipos interdisciplinarios.' },
  { name: 'Gestión de Propiedad Intelectual', text: 'Asesoramiento para proteger y valorizar las innovaciones alcanzadas.' },
];
---

<BaseLayout
  title="Gimnasio de Innovación GII 5.0 · Entrenamientos DIT | Interactiva Hub"
  description="Entrenando el futuro: programas de alto rendimiento, el Dispositivo DIT de 9 pasos para gestionar eficientemente las fuentes del saber y servicios de infraestructura de pensamiento para organizaciones del Chaco."
  active="/gimnasio"
>
  <UnitHero
    title="Gimnasio de Innovación"
    eyebrow="Entrenando el Futuro · GII 5.0"
    lead="En el Gimnasio de Innovación entendemos que la innovación no es un patio de recreo ni un espacio de bienestar relajado; es un gimnasio donde las organizaciones alcanzan sus metas mediante el entrenamiento riguroso y el coaching especializado."
    logo={unit.logo}
    logoAlt="Logo del Gimnasio de Innovación GII 5.0"
    accent={unit.accent}
    minHeight={460}
  >
    <Button href="#contacto" iconRight="→">Entrená tu competitividad</Button>
    <Button href="#trayectoria" variant="ghost" iconRight="↓">Explorar los 9 pasos</Button>
  </UnitHero>

  <Section labelledby="concepto-title">
    <div id="concepto-title">
      <SectionHeading
        eyebrow="El concepto"
        title="Innovar no es crear tecnología, innovar es crear Valor"
        lead="Colaboramos con emprendedores y organizaciones que buscan anticiparse al futuro y profesionalizar sus procesos internos a través del diseño estratégico."
        accent={unit.solid}
      />
    </div>
    <div class="cards cards-3">
      {
        pillars.map((p) => (
          <article class="card">
            <div class="label">{p.label} de GII 5.0</div>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <div id="trayectoria">
    <SpaceHero background="dawn" minHeight={0}>
      <div class="dit">
        <div class="dit-intro">
          <SectionHeading
            eyebrow="Metodología DIT · Los 9 Pasos de la Transformación"
            title="Dispositivo DIT: 9 pasos, una trayectoria"
            lead="El Dispositivo de Innovación y Transformación (DIT) no es una creación nuestra: es una metodología existente que adoptamos y recomendamos. Propone un camino secuencial y modular de 9 pasos para gestionar eficientemente las fuentes del saber, minimizar los riesgos de fracaso y transformar la visión en resultados medibles y sostenibles."
            accent={unit.solid}
          />
          <div class="planet-wrap" aria-hidden="true">
            <Planet size={240} float><img src={nasaImages.astronautLunar} alt="" loading="lazy" /></Planet>
          </div>
        </div>
        <ol class="steps">
          {ditSteps.map((s, i) => <li><StepItem n={i + 1} title={s.title} text={s.text} accent={unit.solid} /></li>)}
        </ol>
      </div>
    </SpaceHero>
  </div>

  <Section labelledby="enfoque-title">
    <div id="enfoque-title">
      <SectionHeading
        eyebrow="Entrenamiento Estratégico"
        title="La innovación no se improvisa: se entrena"
        lead="En Interactiva Hub abordamos la innovación como una disciplina de alto rendimiento. El Dispositivo DIT estructura el recorrido en tres fases integradas para asegurar coherencia, solidez y minimización de riesgos."
        accent={unit.solid}
      />
    </div>
    <div class="cards cards-3">
      {
        phases.map((p) => (
          <article class="card">
            <div class="phase-badge">
              <span class="label">{p.phase}</span>
              <span class="phase-range">{p.stepsRange}</span>
            </div>
            <h3>{p.name}</h3>
            <p>{p.description}</p>
            <ul class="phase-bullets">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </Section>

  <Section background="sky" labelledby="modalidades-title">
    <div id="modalidades-title">
      <SectionHeading
        eyebrow="Programas de Alto Rendimiento"
        title="¿Cómo podés entrenar con nosotros?"
        lead={'Ofrecemos programas específicos para que las empresas y nanoempresas chaqueñas desarrollen sus "músculos" tecnológicos y estratégicos, con propuestas diseñadas para adaptarse al estadio de madurez y a los objetivos estratégicos de cada equipo.'}
        accent={unit.solid}
      />
    </div>
    <div class="cards cards-3">
      {
        modalities.map((m) => (
          <article class="card" id={m.id}>
            <h3>{m.title}</h3>
            <div class="modality-lead">{m.lead}</div>
            <p>{m.text}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section labelledby="infra-title">
    <div id="infra-title">
      <SectionHeading
        eyebrow="Servicios"
        title="Servicios de Infraestructura de Pensamiento"
        lead={'El gimnasio provee herramientas para la "descarga cognitiva", permitiendo que los equipos externalicen su estrategia en soportes visuales para enfocarse en conectar ideas y detectar incoherencias estratégicas.'}
        accent={unit.solid}
      />
    </div>
    <ul class="cards cards-3 infra">
      {infra.map((i) => <li class="card"><h3>{i.name}</h3><p>{i.text}</p></li>)}
    </ul>

    <div class="ecosystem-banner">
      <div>
        <div class="eco-eyebrow">Ecosistema Integrado</div>
        <h3>Entrená en el Gimnasio de Innovación de Interactiva Hub</h3>
        <p>
          Combinamos infraestructura de pensamiento, laboratorios phygital y el espacio colaborativo de nuestro coworking en Resistencia para impulsar el crecimiento de tu organización.
        </p>
      </div>
      <div class="eco-actions">
        <Button href="/coworking" variant="ghost">Ver Espacios Coworking</Button>
      </div>
    </div>
  </Section>

  <Section background="sky" labelledby="humano-title">
    <div id="humano-title">
      <SectionHeading
        eyebrow="El Factor Humano"
        title="¿Estás listo para entrenar tu competitividad?"
        lead="Ofrecemos lo que la Inteligencia Artificial no puede generar: empatía, experiencia y acompañamiento humano en cada etapa del cambio organizacional. Transformemos juntos el conocimiento en oportunidades de negocio."
        accent={unit.solid}
      />
    </div>
    <div class="humano-actions">
      <Button href="/contacto" iconRight="→">Agendá un diagnóstico</Button>
    </div>
  </Section>

  <div id="contacto">
    <ContactBlock
      email="kiskza.consultora@gmail.com"
      emailLabel="Esp. María José Kiszka, Directora Ejecutiva · Gimnasio de Innovación"
      accent={unit.solid}
    />
  </div>
</BaseLayout>

<style>
  .cards { display: grid; gap: 24px; margin-top: 56px; }
  .cards-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .infra { list-style: none; padding: 0; margin-bottom: 0; }
  .card { border: 1px solid var(--line-1); border-top: 6px solid var(--gii-2); padding: 28px 24px; background: var(--paper-0); display: grid; gap: 12px; align-content: start; }
  .label { font: var(--type-eyebrow); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gii-2); }
  p { font: 400 16px/1.55 var(--font-body); color: var(--ink-2); }
  h3 { font: var(--type-h3); color: var(--space-ink); }

  .dit { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 64px; }
  .dit-intro { display: grid; gap: var(--space-6); align-content: start; }
  .planet-wrap { display: flex; justify-content: center; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 28px; }

  .phase-badge { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
  .phase-range { font: 400 13px var(--font-body); color: var(--ink-3); }
  .phase-bullets { list-style: none; margin: 8px 0 0; padding: 12px 0 0; display: grid; gap: 8px; border-top: 1px solid var(--line-1); }
  .phase-bullets li { font: 400 14px/1.45 var(--font-body); color: var(--ink-3); position: relative; padding-left: 16px; }
  .phase-bullets li::before { content: '→'; position: absolute; left: 0; color: var(--gii-2); font-weight: 700; }

  .modality-lead { font: 600 13px var(--font-condensed); letter-spacing: 0.1em; text-transform: uppercase; color: var(--gii-2); }

  .ecosystem-banner {
    margin-top: 56px;
    padding: 40px;
    background: linear-gradient(135deg, var(--sky-1) 0%, var(--paper-0) 100%);
    border: 1px solid var(--sky-3);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }
  .eco-eyebrow { font: var(--type-eyebrow); letter-spacing: 0.14em; text-transform: uppercase; color: var(--sky-5); margin-bottom: 8px; }
  .ecosystem-banner h3 { font: var(--type-h2); margin-bottom: 12px; }
  .eco-actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: flex-end; }
  .humano-actions { margin-top: 32px; }

  @media (max-width: 1100px) {
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cards-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .dit, .ecosystem-banner { grid-template-columns: 1fr; gap: var(--space-6); }
    .planet-wrap, .eco-actions { justify-content: flex-start; }
  }
  @media (max-width: 650px) {
    .cards-3, .steps { grid-template-columns: 1fr; }
    .ecosystem-banner { padding: 24px; }
  }
</style>
