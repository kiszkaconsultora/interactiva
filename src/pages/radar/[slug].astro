---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { withBase } from '../../utils/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/marketing/Section.astro';

export async function getStaticPaths() {
  const articles = await getCollection('radar', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: CollectionEntry<'radar'>;
}

const { article } = Astro.props;
const { title, excerpt, date, category, image, imageAlt, author } = article.data;
const { Content } = await render(article);

// UTC keeps the date from shifting a day for front-matter dates without a time.
const dateLabel = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
---

<BaseLayout title={`${title} · Radar · Interactiva Hub`} description={excerpt} active="/radar">
  <Section labelledby="article-title">
    <article class="article">
      <a class="back" href={withBase('/radar')}>← Todas las notas</a>
      <div class="bar" aria-hidden="true"></div>
      <div class="meta">
        <span class="category">{category}</span>
        <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
        {author && <span>Por {author}</span>}
      </div>
      <h1 id="article-title">{title}</h1>
      <p class="lead">{excerpt}</p>
      <img class="cover" src={withBase(image)} alt={imageAlt} />
      <div class="prose">
        <Content />
      </div>
    </article>
  </Section>
</BaseLayout>

<style>
  .article { max-width: 720px; margin: 0 auto; display: grid; gap: 18px; }
  .back { font: 500 15px var(--font-body); justify-self: start; }
  .bar { width: 96px; height: 6px; background: var(--ink-0); }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-family: var(--font-condensed);
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .category { color: var(--ink-0); font-weight: 500; }
  h1 { font: var(--fw-black) clamp(34px, 4.6vw, 56px) / var(--lh-tight) var(--font-display); letter-spacing: -0.03em; color: var(--space-ink); margin: 0; }
  .lead { font: 400 var(--fs-lead) / 1.45 var(--font-body); color: var(--ink-1); margin: 0; }
  .cover { width: 100%; height: auto; display: block; border-radius: 4px; margin-top: 8px; }

  /* Rendered Markdown body: elements come from <Content />, so styles must be global within .prose. */
  .prose { margin-top: 16px; font: 400 18px/1.7 var(--font-body); color: var(--ink-1); }
  .prose > :global(* + *) { margin-top: 1.1em; }
  .prose :global(h2) { font: 700 clamp(24px, 3vw, 30px) / 1.2 var(--font-display); color: var(--ink-0); margin-top: 1.8em; }
  .prose :global(h3) { font: 700 clamp(20px, 2.4vw, 24px) / 1.25 var(--font-display); color: var(--ink-0); margin-top: 1.6em; }
  .prose :global(h4) { font: 700 18px/1.3 var(--font-display); color: var(--ink-0); margin-top: 1.4em; }
  .prose :global(p) { margin-bottom: 0; }
  .prose :global(ul),
  .prose :global(ol) { padding-left: 1.4em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(a) { color: var(--link); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--link-hover); }
  .prose :global(strong) { font-weight: 700; color: var(--ink-0); }
  .prose :global(blockquote) {
    margin-left: 0;
    margin-right: 0;
    padding: 4px 0 4px 20px;
    border-left: 6px solid var(--ink-0);
    font-style: italic;
    color: var(--ink-2);
  }
  .prose :global(img) { max-width: 100%; height: auto; display: block; border-radius: 4px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line-1); margin: 2em 0; }
  .prose :global(code) { font-size: 0.9em; background: var(--paper-2); padding: 0.1em 0.35em; border-radius: 3px; }

  @media (max-width: 560px) {
    .prose { font-size: 17px; }
  }
</style>
