---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/core/Button.astro';

import Section from '../components/marketing/Section.astro';
import SectionHeading from '../components/marketing/SectionHeading.astro';
import UnitHero from '../components/marketing/UnitHero.astro';
import { contact, emails } from '../data/site';
---

<BaseLayout
  title="Contacto · Interactiva Hub"
  description="Escribinos o visitanos en Av. Edison 636, Resistencia, Chaco. Teléfono, WhatsApp y emails de cada unidad."
>
  <UnitHero
    title="Contacto"
    eyebrow="Interactiva Hub"
    lead="Estamos a un mensaje de distancia. Escribinos y armamos una propuesta a tu medida."
    accent="var(--ink-0)"
    minHeight={320}
  />

  <Section labelledby="datos-title">
    <div class="layout">
      <div class="info">
        <div id="datos-title"><SectionHeading eyebrow="Datos" title="Dónde encontrarnos" accent="var(--ink-0)" /></div>
        <dl>
          <div><dt>Dirección</dt><dd>{contact.address}</dd></div>
          <div><dt>Horario</dt><dd>{contact.hours}</dd></div>
          <div><dt>Teléfono</dt><dd><a href={contact.phoneHref}>{contact.phoneDisplay}</a></dd></div>
        </dl>
        <div><Button href={contact.whatsappHref} iconRight="→">Escribinos por WhatsApp</Button></div>
      </div>
      <div class="emails-column">
        <h2 id="emails-title">Emails por unidad</h2>
        <ul class="emails">
          {emails.map((e) => <li><span>{e.label}</span><a href={`mailto:${e.email}`}>{e.email}</a></li>)}
        </ul>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: start; }
  .info { display: grid; gap: 28px; justify-items: start; }
  .emails-column { display: grid; gap: 20px; }
  dl { display: grid; gap: 20px; margin: 0; }
  dt { font: var(--type-eyebrow); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 4px; }
  dd { margin: 0; font: 400 18px/1.4 var(--font-body); color: var(--space-ink); }
  h2 { font: var(--type-h3); color: var(--space-ink); margin: 0; }
  .emails { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; width: 100%; }
  .emails li { display: grid; gap: 2px; border-top: 1px solid var(--line-1); padding-top: 12px; }
  .emails span { font: 500 15px var(--font-body); color: var(--ink-3); }
  .emails a { overflow-wrap: anywhere; font: 500 17px var(--font-body); }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; gap: var(--space-7); }
  }
</style>
