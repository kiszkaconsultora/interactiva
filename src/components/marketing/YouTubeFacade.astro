---
interface Props {
  id: string;
  title?: string;
}
const { id, title } = Astro.props;
const label = title || 'Video de YouTube';
---

<div class="yt" data-yt-id={id} data-yt-title={label}>
  <button type="button" class="play" aria-label={`Reproducir: ${label}`}>
    <img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
    <span class="icon" aria-hidden="true">▶</span>
  </button>
  {title && <div class="caption">{title}</div>}
</div>

<style>
  .yt { display: grid; gap: 10px; align-content: start; }
  .play { position: relative; display: block; width: 100%; aspect-ratio: 16 / 9; padding: 0; border: 0; cursor: pointer; background: var(--space-ink); overflow: hidden; }
  .play img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .icon { position: absolute; inset: 0; margin: auto; width: 64px; height: 64px; display: grid; place-items: center; background: var(--ink-0); color: var(--paper-1); font-size: 24px; transition: transform var(--dur-base); }
  .play:hover .icon, .play:focus-visible .icon { transform: scale(1.08); }
  .play:focus-visible { outline: 3px solid var(--sky-5); outline-offset: 2px; }
  .caption { font: 500 15px/1.4 var(--font-body); color: var(--ink-2); }
  :global(.yt iframe) { width: 100%; aspect-ratio: 16 / 9; border: 0; display: block; }
</style>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.yt .play');
    if (!btn) return;
    const host = btn.closest<HTMLElement>('.yt');
    if (!host?.dataset.ytId) return;
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${host.dataset.ytId}?autoplay=1`;
    iframe.title = host.dataset.ytTitle ?? 'Video de YouTube';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    btn.replaceWith(iframe);
    iframe.focus();
  });
</script>
