---
import { withBase } from '../../utils/url';
interface Props {
  href: string;
  title: string;
  excerpt: string;
  category: string;
  date: Date;
  image: string;
  imageAlt: string;
  accent?: string;
}
const { href, title, excerpt, category, date, image, imageAlt, accent = 'var(--ink-0)' } = Astro.props;

// UTC keeps the date from shifting a day for front-matter dates without a time.
const dateLabel = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(date);
---

<a class="card" href={withBase(href)} style={`--accent:${accent}`}>
  <div class="photo"><img src={withBase(image)} alt={imageAlt} loading="lazy" /></div>
  <div class="bar"></div>
  <div class="body">
    <div class="meta">
      <span class="category">{category}</span>
      <time datetime={date.toISOString().slice(0, 10)}>{dateLabel}</time>
    </div>
    <h3 class="title">{title}</h3>
    <p class="excerpt">{excerpt}</p>
    <div class="cta">Leer nota →</div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink-0);
    background: var(--paper-0);
    border: 1px solid var(--line-1);
    transition: box-shadow var(--dur-base);
  }
  .card:hover { box-shadow: var(--shadow-2); color: var(--ink-0); }
  .photo { aspect-ratio: 16 / 10; overflow: hidden; background: var(--paper-2); }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .card:hover .photo img { transform: scale(1.03); }
  .bar { height: 6px; background: var(--accent); }
  .body { padding: 22px; display: grid; gap: 10px; flex: 1; align-content: start; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    font-family: var(--font-condensed);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .category { color: var(--ink-0); font-weight: 500; }
  .title { font: 700 22px/1.2 var(--font-display); margin: 0; }
  .excerpt { font: 400 15px/1.5 var(--font-body); color: var(--ink-2); margin: 0; }
  .cta { margin-top: auto; padding-top: 8px; font: 500 15px var(--font-body); text-underline-offset: 4px; }
  .card:hover .cta { text-decoration: underline; }
</style>
