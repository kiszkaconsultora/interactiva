---
import SpaceHero from './SpaceHero.astro';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  logo?: string;
  logoAlt?: string;
  /** Gradient or solid for the 6px accent bar. */
  accent?: string;
  minHeight?: number;
}
const { title, lead, eyebrow, logo, logoAlt = '', accent = 'var(--ink-0)', minHeight = 420 } = Astro.props;
---

<SpaceHero background="sky" minHeight={minHeight}>
  <div class="unit-hero" style={`--accent:${accent}`}>
    {logo && <img class="logo" src={logo} alt={logoAlt} />}
    <div class="copy">
      <div class="bar" aria-hidden="true"></div>
      {eyebrow && <div class="eyebrow">{eyebrow}</div>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <div class="extra"><slot /></div>
    </div>
  </div>
</SpaceHero>

<style>
  .unit-hero { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--space-7); align-items: center; }
  .logo { width: 180px; height: 180px; object-fit: contain; }
  .copy { display: grid; gap: 20px; justify-items: start; }
  .bar { width: 96px; height: 6px; background: var(--accent); }
  .eyebrow { font: var(--type-eyebrow); letter-spacing: 0.14em; text-transform: uppercase; color: var(--sky-5); }
  h1 { font: var(--fw-black) clamp(34px, 4.6vw, 64px) / var(--lh-tight) var(--font-display); letter-spacing: -0.03em; color: var(--space-ink); }
  .lead { font: 400 var(--fs-lead) / 1.5 var(--font-body); color: var(--ink-2); max-width: 680px; }
  .extra:empty { display: none; }
  .extra { display: flex; gap: 12px; flex-wrap: wrap; }
  @media (max-width: 700px) {
    .unit-hero { grid-template-columns: 1fr; gap: var(--space-5); }
    .logo { width: 110px; height: 110px; }
  }
</style>
