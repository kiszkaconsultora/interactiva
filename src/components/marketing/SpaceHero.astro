---
import { withBase } from '../../utils/url';
interface Props {
  background?: 'white' | 'sky' | 'dawn' | 'image';
  image?: string;
  minHeight?: number;
  align?: 'left' | 'center' | 'right';
  class?: string;
}
const { background = 'sky', image, minHeight = 560, align = 'left', class: className } = Astro.props;
const backgrounds = {
  white: 'var(--sky-0)',
  sky: 'var(--grad-sky)',
  dawn: 'var(--grad-dawn)',
  image: 'var(--sky-1)',
};
const bg = backgrounds[background] ?? backgrounds.sky;
---

<section class:list={['hero', className]} style={`--bg:${bg};--min-h:${minHeight}px;--align:${align}`}>
  {
    background === 'image' && image && (
      <>
        <img class="cover" src={withBase(image)} alt="" />
        <div class="fade"></div>
      </>
    )
  }
  <div class="inner"><slot /></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--bg);
    min-height: var(--min-h);
    display: flex;
    align-items: center;
  }
  .cover { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .fade { position: absolute; inset: 0; background: var(--grad-fade-white); pointer-events: none; }
  .inner {
    position: relative;
    width: 100%;
    max-width: var(--container);
    margin: 0 auto;
    padding: 120px var(--gutter);
    text-align: var(--align);
  }
  @media (max-width: 900px) {
    .inner { padding: var(--space-9) var(--space-5); }
  }
  @media (max-width: 600px) {
    .inner { padding: var(--space-8) var(--space-4); }
  }
</style>
