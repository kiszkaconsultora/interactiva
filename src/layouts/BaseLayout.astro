---
import '../styles/global.css';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  navLinks?: { label: string; href: string }[];
  active?: string;
  ctaHref?: string;
  footerColumns?: { title: string; links: { label: string; href: string }[] }[];
  footerMarks?: { src: string; alt?: string }[];
}

const {
  title,
  description = 'Interactiva Hub: coworking e innovación en Resistencia, Chaco.',
  navLinks = [],
  active,
  ctaHref = '/contacto',
  footerColumns = [],
  footerMarks = [],
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader links={navLinks} active={active} ctaHref={ctaHref} />
    <main><slot /></main>
    <SiteFooter columns={footerColumns} marks={footerMarks} />
  </body>
</html>

<style is:global>
  html { overflow-x: hidden; }
</style>
