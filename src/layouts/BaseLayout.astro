---
import '../styles/global.css';
import SiteHeader from '../components/navigation/SiteHeader.astro';
import SiteFooter from '../components/navigation/SiteFooter.astro';
import { stripBase, withBase } from '../utils/url';
import { navLinks as defaultNav, contact, emails } from '../data/site';
import { units, ecosystem } from '../data/units';
import { streamPrograms } from '../data/streamPrograms';

const defaultColumns = [
  {
    title: 'Unidades',
    links: [
      ...units.filter((u) => u.slug !== 'stream').map((u) => ({ label: u.name, href: u.href })),
    ],
  },
  {
    title: 'Stream',
    links: [{ label: 'Todo el Stream', href: '/stream' }, ...streamPrograms.map((p) => ({ label: p.name, href: `/stream/${p.slug}` }))],
  },
  {
    title: 'Contacto',
    links: [
      { label: contact.phoneDisplay, href: contact.phoneHref },
      { label: 'WhatsApp', href: contact.whatsappHref },
      ...emails.map((e) => ({ label: `${e.label}: ${e.email}`, href: `mailto:${e.email}` })),
      { label: 'Formulario de contacto', href: '/contacto' },
    ],
  },
];
const defaultMarks = [...units.map((u) => ({ src: u.logo, alt: u.name })), ...ecosystem.map((e) => ({ src: e.logo, alt: e.name }))].filter(
  (m, i, a) => a.findIndex((x) => x.src === m.src) === i,
);

interface Props {
  title: string;
  description?: string;
  navLinks?: { label: string; href: string }[];
  active?: string;
  cta?: string;
  ctaHref?: string;
  footerColumns?: { title: string; links: { label: string; href: string }[] }[];
  footerMarks?: { src: string; alt?: string }[];
}

const {
  title,
  description = 'Interactiva Hub: coworking e innovación en Resistencia, Chaco.',
  navLinks = defaultNav,
  active,
  cta = 'Agendá una reunión',
  ctaHref = '/contacto',
  footerColumns = defaultColumns,
  footerMarks = defaultMarks,
} = Astro.props;

const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const current =
  active ??
  navLinks.find((l) => (l.href === '/' ? path === '/' : path === l.href || path.startsWith(l.href + '/')))?.href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/x-icon" href={withBase('/favicon.ico')} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader links={navLinks} active={current} cta={cta} ctaHref={ctaHref} />
    <main><slot /></main>
    <SiteFooter columns={footerColumns} marks={footerMarks} />
  </body>
</html>

<style is:global>
  html { overflow-x: hidden; }
</style>
